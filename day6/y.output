Terminals which are not used

   LBRACE
   RBRACE
   COMMA
   BIT_AND
   BIT_OR
   COLON
   DOT
   CR
   SPACE
   ENDOFFILE
   IF
   ELSE
   ELSIF
   WHILE
   FOR
   RETURN
   BREAK
   CONTINUE
   BOOLEAN_T
   INT_T
   DOUBLE_T
   STRING_T


Grammar

    0 $accept: translation_unit $end

    1 translation_unit: statement_list

    2 statement_list: statement
    3               | statement_list statement

    4 statement: expression SEMICOLON

    5 expression: assignment_expression

    6 assignment_expression: logical_or_expression
    7                      | postfix_expression assignment_operator assignment_expression

    8 assignment_operator: ASSIGN
    9                    | ADD_ASSIGN
   10                    | SUB_ASSIGN
   11                    | MUL_ASSIGN
   12                    | DIV_ASSIGN
   13                    | MOD_ASSIGN

   14 logical_or_expression: logical_and_expression
   15                      | logical_or_expression OR logical_and_expression

   16 logical_and_expression: equality_expression
   17                       | logical_and_expression AND equality_expression

   18 equality_expression: relational_expression
   19                    | equality_expression EQ relational_expression
   20                    | equality_expression NE relational_expression

   21 relational_expression: additive_expression
   22                      | relational_expression GT additive_expression
   23                      | relational_expression GE additive_expression
   24                      | relational_expression LE additive_expression
   25                      | relational_expression LT additive_expression

   26 additive_expression: multiplicative_expression
   27                    | additive_expression ADD multiplicative_expression
   28                    | additive_expression SUB multiplicative_expression

   29 multiplicative_expression: unary_expression
   30                          | multiplicative_expression MUL unary_expression
   31                          | multiplicative_expression DIV unary_expression
   32                          | multiplicative_expression MOD unary_expression

   33 unary_expression: postfix_expression
   34                 | SUB unary_expression
   35                 | NOT unary_expression

   36 postfix_expression: primary_expression
   37                   | postfix_expression LPAREN RPAREN
   38                   | postfix_expression INCREMENT
   39                   | postfix_expression DECREMENT

   40 primary_expression: LPAREN expression RPAREN
   41                   | IDENTIFIER
   42                   | INT_LITERAL
   43                   | DOUBLE_LITERAL
   44                   | TRUE
   45                   | FALSE


