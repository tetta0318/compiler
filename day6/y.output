state 0

    0 $accept: . translation_unit $end

    LPAREN          shift, and go to state 1
    SUB             shift, and go to state 2
    NOT             shift, and go to state 3
    INT_LITERAL     shift, and go to state 4
    DOUBLE_LITERAL  shift, and go to state 5
    IDENTIFIER      shift, and go to state 6
    TRUE            shift, and go to state 7
    FALSE           shift, and go to state 8

    translation_unit           go to state 9
    statement                  go to state 10
    expression                 go to state 11
    assignment_expression      go to state 12
    logical_or_expression      go to state 13
    logical_and_expression     go to state 14
    equality_expression        go to state 15
    relational_expression      go to state 16
    additive_expression        go to state 17
    multiplicative_expression  go to state 18
    unary_expresion            go to state 19
    postfix_expression         go to state 20
    primary_expression         go to state 21


