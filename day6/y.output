Terminals which are not used

   LBRACE
   RBRACE
   COMMA
   BIT_AND
   BIT_OR
   COLON
   DOT
   CR
   SPACE
   ENDOFFILE
   IF
   ELSE
   ELSIF
   WHILE
   FOR
   RETURN
   BREAK
   CONTINUE
   BOOLEAN_T
   INT_T
   DOUBLE_T
   STRING_T


Grammar

    0 $accept: translation_unit $end

    1 translation_unit: statement

    2 statement: expression SEMICOLON

    3 expression: assignment_expression

    4 assignment_expression: logical_or_expression
    5                      | postfix_expression assignment_operator assignment_expression

    6 assignment_operator: ASSIGN
    7                    | ADD_ASSIGN
    8                    | SUB_ASSIGN
    9                    | MUL_ASSIGN
   10                    | DIV_ASSIGN
   11                    | MOD_ASSIGN

   12 logical_or_expression: logical_and_expression
   13                      | logical_or_expression OR logical_and_expression

   14 logical_and_expression: equality_expression
   15                       | logical_and_expression AND equality_expression

   16 equality_expression: relational_expression
   17                    | equality_expression EQ relational_expression
   18                    | equality_expression NE relational_expression

   19 relational_expression: additive_expression
   20                      | relational_expression GT additive_expression
   21                      | relational_expression GE additive_expression
   22                      | relational_expression LT additive_expression
   23                      | relational_expression LE additive_expression

   24 additive_expression: multiplicative_expression
   25                    | additive_expression ADD multiplicative_expression
   26                    | additive_expression SUB multiplicative_expression

   27 multiplicative_expression: unary_expresion
   28                          | multiplicative_expression MUL unary_expresion
   29                          | multiplicative_expression DIV unary_expresion
   30                          | multiplicative_expression MOD unary_expresion

   31 unary_expresion: postfix_expression
   32                | SUB unary_expresion
   33                | NOT unary_expresion

   34 postfix_expression: primary_expression
   35                   | postfix_expression LPAREN RPAREN
   36                   | postfix_expression INCREMENT
   37                   | postfix_expression DECREMENT

   38 primary_expression: LPAREN expression RPAREN
   39                   | IDENTIFIER
   40                   | INT_LITERAL
   41                   | DOUBLE_LITERAL
   42                   | TRUE
   43                   | FALSE


