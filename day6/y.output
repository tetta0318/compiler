state 0

    0 $accept: . translation_unit $end

    LPAREN          shift, and go to state 1
    SUB             shift, and go to state 2
    NOT             shift, and go to state 3
    INT_LITERAL     shift, and go to state 4
    DOUBLE_LITERAL  shift, and go to state 5
    IDENTIFIER      shift, and go to state 6
    TRUE            shift, and go to state 7
    FALSE           shift, and go to state 8

    translation_unit           go to state 9
    statement_list             go to state 10
    statement                  go to state 11
    expression                 go to state 12
    assignment_expression      go to state 13
    logical_or_expression      go to state 14
    logical_and_expression     go to state 15
    equality_expression        go to state 16
    relational_expression      go to state 17
    additive_expression        go to state 18
    multiplicative_expression  go to state 19
    unary_expression           go to state 20
    postfix_expression         go to state 21
    primary_expression         go to state 22


state 1

   40 primary_expression: LPAREN . expression RPAREN

    LPAREN          shift, and go to state 1
    SUB             shift, and go to state 2
    NOT             shift, and go to state 3
    INT_LITERAL     shift, and go to state 4
    DOUBLE_LITERAL  shift, and go to state 5
    IDENTIFIER      shift, and go to state 6
    TRUE            shift, and go to state 7
    FALSE           shift, and go to state 8

    expression                 go to state 23
    assignment_expression      go to state 13
    logical_or_expression      go to state 14
    logical_and_expression     go to state 15
    equality_expression        go to state 16
    relational_expression      go to state 17
    additive_expression        go to state 18
    multiplicative_expression  go to state 19
    unary_expression           go to state 20
    postfix_expression         go to state 21
    primary_expression         go to state 22


state 2

   34 unary_expression: SUB . unary_expression

